# Port the HTTP server listens on
PORT=3000
# Bind address. Keep 127.0.0.1 while running locally; set 0.0.0.0 behind a reverse proxy.
HOST=127.0.0.1
# Where the SQLite database lives
DATA_DIR=./data
# Set to 1 when running behind an HTTPS reverse proxy (Caddy, nginx, Cloudflare Tunnel).
# Enables secure cookies and trusts X-Forwarded-* headers.
BEHIND_PROXY=0
# Optional: GitHub token (repo scope, read-only is enough) used to show PR/issue state on cards.
GITHUB_TOKEN=
