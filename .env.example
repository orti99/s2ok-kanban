# Copy to .env. Read by `npm start` (Node --env-file) and by docker compose (variable substitution).

# ---- Node app ----
# Port the HTTP server listens on (inside Docker this is always 3000; use KANBAN_PORT below instead)
PORT=3000
# Bind address. Keep 127.0.0.1 while running locally; set 0.0.0.0 behind a reverse proxy.
HOST=127.0.0.1
# Where the SQLite database lives
DATA_DIR=./data
# Set to 1 when running behind an HTTPS reverse proxy (Synology DSM, Caddy, nginx, Cloudflare Tunnel).
# Enables secure cookies and trusts X-Forwarded-* headers.
BEHIND_PROXY=0
# Accounts created on first start when no users exist (name:admin marks an admin). Passwords are printed once.
BOOTSTRAP_USERS=sebastian:admin,sina
# Optional: GitHub token (fine-grained, read-only on Pull requests + Issues) for PR/issue badges on private repos.
GITHUB_TOKEN=

# ---- docker compose only ----
# User/group the container runs as. Must own the ./data folder. On a Synology run `id` over SSH.
PUID=1000
PGID=100
# Port published on the host (Docker only)
KANBAN_PORT=3000
